{
  "name": "oralscale",
  "version": "0.1.0-alpha.2",
  "description": "Scalable, privacy-preserving oral assessment using Purdue's teaching tools, built with MAGE.",
  "type": "commonjs",
  "scripts": {
    "setup": "node tools/setup.js",
    "guard:install": "node tools/check-secrets.js --install",
    "guard": "node tools/check-secrets.js --all",
    "signer": "node server/signer.js",
    "web": "node tools/serve-web.js",
    "config": "node tools/make-config.js",
    "url": "node tools/gen-url.js",
    "keys": "node tools/gen-access-keys.js",
    "validate": "node tools/validate-bank.js",
    "build:worker": "node tools/build-worker.js",
    "build:autograder": "node tools/build-autograder.js",
    "test:unit": "node tools/test-unit.js",
    "test:e2e": "node tools/demo-e2e.js",
    "test:banks": "node tools/validate-all-banks.js",
    "test:course": "node tools/test-course-smoke.js --course courses/_testsuite/course.json --assignment starter",
    "test": "node tools/test-unit.js && node tools/test-worker.js && node tools/demo-e2e.js",
    "deploy": "bash tools/deploy.sh",
    "package": "node tools/build-autograder.js --zip",
    "test:worker": "node tools/test-worker.js",
    "test:package": "node tools/test-package.js",
    "launch": "node tools/launch.js",
    "guides:build": "node tools/public-guides/build.cjs",
    "guides:capture": "node tools/public-guides/capture.cjs",
    "guides:render": "node tools/public-guides/render.cjs",
    "test:guides": "node tools/public-guides/check.cjs",
    "test:guides:release": "node tools/public-guides/check.cjs --release"
  },
  "license": "MIT",
  "author": "David I. Inouye (https://www.davidinouye.com)",
  "homepage": "https://www.davidinouye.com"
}
